# Kopier denne filen til .env og fyll inn dine nøkler
# cp .env.example .env

# --- Anthropic (Claude) ---
# Lag nøkkel på: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- OpenAI ---
# Lag nøkkel på: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# --- Azure OpenAI ---
# Finn disse i Azure-portalen under din OpenAI-ressurs
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- AWS Bedrock ---
# Bruk IAM-bruker eller rolle med Bedrock-tilgang
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
